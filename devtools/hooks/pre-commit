#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

staged_files=()
while IFS= read -r -d '' file; do
  case "${file}" in
    third_party/*) continue ;;
  esac

  if [[ -f "${file}" && ! -L "${file}" ]]; then
    staged_files+=("${file}")
  fi
done < <(
  git diff --cached --name-only --diff-filter=ACMR -z -- \
    '*.c' '*.cc' '*.cpp' '*.cxx' \
    '*.h' '*.hh' '*.hpp' '*.hxx' \
    '*.cu' '*.cuh'
)

if (( ${#staged_files[@]} == 0 )); then
  exit 0
fi

if ! command -v clang-format >/dev/null 2>&1; then
  echo "clang-format is required. Run this commit inside the ADLabel development container." >&2
  exit 1
fi

echo "Formatting ${#staged_files[@]} staged C/C++ file(s)..."
clang-format --style=file -i "${staged_files[@]}"
git add -- "${staged_files[@]}"
