module(
    name = "adlabel",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4")

# Wrap system libraries installed via apt in the Docker image.
# path="/usr" means all targets in system_libs.BUILD are relative to /usr.
new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

new_local_repository(
    name = "system_libs",
    path = "/usr",
    build_file = "//third_party:system_libs.BUILD",
)

# GTSAM installs to /usr/local (built from source, not via apt).
new_local_repository(
    name = "local_libs",
    path = "/usr/local",
    build_file = "//third_party:local_libs.BUILD",
)