# .bazelrc
# Keep Bazel output inside the workspace so the cache survives container restarts.
startup --output_user_root=/workspace/ADLabel/.cache/bazel

# Disable the repo contents cache to avoid caching inside the main workspace.
build --repository_cache=/workspace/ADLabel/.cache/bazel/repository_cache
common --repo_contents_cache=

# Compile all C++ targets as ISO C++17.
build --cxxopt=-std=c++17

# Use optimized builds by default. Override with `-c dbg` when debugging.
build --compilation_mode=opt
